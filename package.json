{
  "name": "nova-browser",
  "productName": "Nova",
  "version": "5.2.0",
  "description": "Navegador Chromium moderno con Nova Quantum 5.2: identidad renovada, interfaz serena, instalador refinado y experiencia consistente.",
  "author": "Nova",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run dist:win",
    "check": "npm run check:project && npm run qa:5.2.0 && npm run check:build-assets",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux rpm AppImage --publish never",
    "qa": "node scripts/qa-vm-4.0.js",
    "check:syntax": "node --check main.js && node --check migration.js && node --check account-service.js && node --check account-server/server.js && node --check shell/extensions.js && node --check shell/extras.js && node --check shell/extras2.js && node --check shell/extras3.js && node --check shell/extras4.js && node --check shell/extras5.js && node --check shell/extras6.js && node --check shell/extras7.js && node --check shell/extras8.js && node --check shell/extras9.js && node --check shell/extras10.js && node --check shell/extras11.js && node --check shell/extras12.js && node --check shell/supercat.js && node --check shell/nova25.js && node --check shell/hotfix254.js && node --check shell/nova30.js && node --check shell/nova31.js && node --check shell/nova40.js && node --check shell/nova50.js",
    "check-hotfix": "node scripts/qa-hotfix-4.3.2.js",
    "check:project": "node scripts/check-project.js",
    "qa:4.4": "node scripts/qa-4.4.1.js",
    "qa:4.4.1": "node scripts/qa-4.4.1.js",
    "qa:5.0.0": "node scripts/qa-5.0.0.js",
    "check:build-assets": "node scripts/check-build-assets.js",
    "qa:5.1.0": "node scripts/qa-5.1.0.js",
    "qa:5.2.0": "node scripts/qa-5.2.0.js"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2",
    "cross-fetch": "4.1.0",
    "sql.js": "1.14.2",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.nova.browser",
    "productName": "Nova",
    "artifactName": "Nova-Setup-${version}.exe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "migration.js",
      "shell/**",
      "assets/**",
      "package.json",
      "account-service.js",
      "account-config.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nova",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "language": "1034",
      "runAfterFinish": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Nova Browser",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Nova-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sdraiky99",
        "repo": "NovaBrowser"
      }
    ],
    "copyright": "Copyright © 2026 Nova",
    "linux": {
      "target": [
        "rpm",
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Network",
      "synopsis": "Navegador web moderno basado en Chromium",
      "description": "Nova es un navegador moderno basado en Chromium con Nova Tab, Study, perfiles, seguridad y rendimiento.",
      "desktop": {
        "entry": {
          "Name": "Nova",
          "Comment": "Navegador web moderno basado en Chromium",
          "Categories": "Network;WebBrowser;",
          "Keywords": "browser;web;internet;nova;",
          "StartupWMClass": "nova-browser",
          "Terminal": false,
          "Type": "Application"
        }
      },
      "artifactName": "Nova-${version}-x86_64.${ext}"
    },
    "rpm": {
      "packageCategory": "Applications/Internet",
      "compression": "xz",
      "depends": [
        "gtk3",
        "nss",
        "libnotify",
        "libXScrnSaver"
      ]
    }
  },
  "homepage": "https://github.com/sdraiky99/NovaBrowser",
  "engines": {
    "node": ">=22.12.0"
  }
}
