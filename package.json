{
  "name": "nova-browser",
  "productName": "Nova",
  "version": "2.5.2",
  "description": "Navegador Chromium minimalista con Nova Air, Safari Mode, Islands, Focus, Writer, DOCX, Study, privacidad y rendimiento",
  "author": "Nova",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run dist:win",
    "check": "node --check main.js && node --check preload.js && node --check migration.js && node --check account-service.js && node --check account-server/server.js && node --check shell/shell.js && node --check shell/extensions.js && node --check shell/features.js && node scripts/check-project.js",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux rpm AppImage --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2",
    "cross-fetch": "4.1.0",
    "sql.js": "1.14.2",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.nova.browser",
    "productName": "Nova",
    "artifactName": "Nova-Setup-${version}.exe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "migration.js",
      "shell/**",
      "assets/**",
      "package.json",
      "account-service.js",
      "account-config.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nova",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "language": "1034",
      "runAfterFinish": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Nova Browser",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Nova-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sdraiky99",
        "repo": "NovaBrowser"
      }
    ],
    "copyright": "Copyright © 2026 Nova",
    "linux": {
      "target": [
        "rpm",
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Network",
      "synopsis": "Navegador web moderno basado en Chromium",
      "description": "Nova es un navegador moderno basado en Chromium con Nova Tab, Study, perfiles, seguridad y rendimiento.",
      "desktop": {
        "entry": {
          "Name": "Nova",
          "Comment": "Navegador web moderno basado en Chromium",
          "Categories": "Network;WebBrowser;",
          "Keywords": "browser;web;internet;nova;",
          "StartupWMClass": "nova-browser",
          "Terminal": false,
          "Type": "Application"
        }
      },
      "artifactName": "Nova-${version}-x86_64.${ext}"
    },
    "rpm": {
      "packageCategory": "Applications/Internet",
      "compression": "xz",
      "depends": [
        "gtk3",
        "nss",
        "libnotify",
        "libXScrnSaver"
      ]
    }
  },
  "homepage": "https://github.com/sdraiky99/NovaBrowser"
}
