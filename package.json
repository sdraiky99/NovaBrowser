{
  "name": "nova-browser",
  "productName": "NOVA",
  "version": "9.0.0",
  "description": "NOVA 9 — navegador Electron/Chromium modular, personalizable y centrado en rendimiento, privacidad y productividad.",
  "author": "Nova",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run dist:win",
    "dist:setup": "electron-builder --win nsis --publish never -c.directories.output=dist/setup",
    "dist:portable": "electron-builder --win portable --publish never -c.directories.output=dist/portable",
    "dist:win": "npm run dist:setup && npm run dist:portable",
    "check": "npm run check:distribution-config && npm run check:project && npm run check:syntax && npm run qa:9 && npm run check:build-assets && npm run check:performance && npm run check:security",
    "check:syntax": "node scripts/check-syntax-all.js",
    "check:project": "node scripts/check-project.js",
    "check:build-assets": "node scripts/check-build-assets.js",
    "check:distribution-config": "node scripts/check-distribution-config.js",
    "check:performance": "node scripts/performance-smoke.js",
    "check:security": "node scripts/check-security.js",
    "qa:9": "node scripts/qa-9.js"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2",
    "cross-fetch": "4.1.0",
    "sql.js": "1.14.2",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.nova.browser",
    "productName": "NOVA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "portable-user-data.js",
      "migration.js",
      "permission-policy.js",
      "shell/**",
      "assets/**",
      "package.json",
      "shell/preload.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/brand/nova.ico"
    },
    "portable": {
      "artifactName": "NOVA-9-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sdraiky99",
        "repo": "NovaBrowser"
      }
    ],
    "copyright": "Copyright © 2026 Nova",
    "nsis": {
      "artifactName": "NOVA-9-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/brand/nova.ico",
      "uninstallerIcon": "assets/brand/nova.ico",
      "installerHeaderIcon": "assets/brand/nova.ico"
    }
  },
  "homepage": "https://github.com/sdraiky99/NovaBrowser",
  "engines": {
    "node": ">=22.12.0"
  }
}
