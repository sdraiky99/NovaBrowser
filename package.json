{
  "name": "nova-browser",
  "productName": "Nova",
  "version": "1.7.0",
  "description": "Navegador web moderno basado en Chromium",
  "author": "Nova",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "check": "node --check main.js && node --check migration.js && node --check shell/extensions.js && node --check shell/tabs.js && node --check shell/extras.js && node --check shell/extras2.js && node --check shell/extras3.js && node --check shell/extras4.js && node --check shell/extras5.js && node --check shell/extras6.js && node scripts/check-project.js"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2",
    "cross-fetch": "4.1.0",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.nova.browser",
    "productName": "Nova",
    "artifactName": "Nova-Setup-${version}.exe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "migration.js",
      "shell/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nova",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "language": "1034",
      "runAfterFinish": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Nova Browser",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Nova-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sdraiky99",
        "repo": "NovaBrowser"
      }
    ],
    "copyright": "Copyright © 2026 Nova"
  },
  "homepage": "https://github.com/sdraiky99/NovaBrowser"
}
