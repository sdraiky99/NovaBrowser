{
  "name": "nova-browser",
  "productName": "Nova",
  "version": "4.0.0",
  "description": "Nova Browser para Windows",
  "author": "Nova",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run dist:win",
    "dist:win": "electron-builder --win --publish never",
    "check:syntax": "node --check main.js && node --check migration.js && node --check account-service.js && node --check shell/extensions.js && node --check shell/extras.js && node --check shell/extras2.js && node --check shell/extras3.js && node --check shell/extras4.js && node --check shell/extras5.js && node --check shell/extras6.js && node --check shell/extras7.js && node --check shell/extras10.js && node --check shell/supercat.js"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2",
    "cross-fetch": "4.1.0",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.nova.browser",
    "productName": "Nova",
    "artifactName": "Nova-Setup-${version}.exe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "migration.js",
      "shell/**",
      "assets/**",
      "package.json",
      "account-service.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nova",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "language": "1034",
      "runAfterFinish": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Nova Browser",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Nova-Portable-${version}.exe"
    },
    "copyright": "Copyright © 2026 Nova"
  },
  "homepage": "https://github.com/sdraiky99/NovaBrowser"
}
