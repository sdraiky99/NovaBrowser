{
  "name": "nova-browser",
  "productName": "Nova",
  "version": "6.2.1",
  "description": "Nova 6.2.1 Portable Stability Update: perfil portable persistente y distribución sin instalador.",
  "author": "Nova",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run dist:portable",
    "dist:portable": "electron-builder --win portable --publish never",
    "dist:win": "npm run dist:portable",
    "check": "npm run check:portable-config && npm run check:project && npm run check:syntax && npm run qa:6.2.1 && npm run check:build-assets",
    "check:syntax": "node scripts/check-syntax-all.js",
    "check:project": "node scripts/check-project.js",
    "check:build-assets": "node scripts/check-build-assets.js",
    "qa:6.2.1": "node scripts/qa-6.2.1.js",
    "check:portable-config": "node scripts/check-portable-config.js"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2",
    "cross-fetch": "4.1.0",
    "sql.js": "1.14.2",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.nova.browser",
    "productName": "Nova",
    "artifactName": "Nova-Portable-${version}.exe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "portable-user-data.js",
      "migration.js",
      "shell/**",
      "assets/**",
      "package.json",
      "account-service.js",
      "account-config.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/brand/nova.ico"
    },
    "portable": {
      "artifactName": "Nova-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sdraiky99",
        "repo": "NovaBrowser"
      }
    ],
    "copyright": "Copyright © 2026 Nova"
  },
  "homepage": "https://github.com/sdraiky99/NovaBrowser",
  "engines": {
    "node": ">=22.12.0"
  }
}
